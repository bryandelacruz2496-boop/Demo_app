MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/beatasai?tls=true
JWT_SECRET=your-strong-random-secret-here-min-32-chars
PORT=5000
NODE_ENV=development

# Field-level encryption key for PII data (guardianContact, address, birthDate)
ENCRYPTION_KEY=your-random-encryption-key-min-32-chars

# File encryption key (defaults to ENCRYPTION_KEY if not set)
FILE_ENCRYPTION_KEY=your-random-file-encryption-key

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# For production:
# NODE_ENV=production
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/beatasai?tls=true
# ALLOWED_ORIGINS=https://yourdomain.com
